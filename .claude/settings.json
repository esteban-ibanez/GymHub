{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch --show-current)",
      "Bash(gh auth status)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(pytest:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git switch:*)",
      "Bash(git branch -d:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr create:*)",
      "Read(./.env)"
    ]
  }
}
